{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROS Desktop",
  "version": "0.1.0",
  "identifier": "com.rosdesktop.app",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROS Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

{
  "name": "ros-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm --dir frontend build",
    "check:frontend": "pnpm --dir frontend typecheck && pnpm --dir frontend build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:versions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-versions.ps1",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0"
  }
}
